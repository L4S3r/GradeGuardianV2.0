# ─────────────────────────────────────────────────────────────────────────────
# GRADEGUARDIAN BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ─────────────────────────────────────────────────────────────────────────────

# 1. Cryptographic Security Keys
# Generate values with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_SALT=your_generated_secret_salt_here
JWT_SECRET=your_generated_jwt_secret_here
HMAC_SECRET=your_generated_hmac_secret_here

# 2. Admin Operations Key (required to call POST /admin/rehash-grades)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_KEY=your_generated_admin_key_here

# 3. Supabase SDK Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_publishable_or_service_key

# 4. Supabase PostgreSQL Connection URL (Use Transaction Pooler on port 6543 for Vercel)
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-[your-region].pooler.supabase.com:6543/postgres?sslmode=require

# 5. App & Security Environment (Set to "production" on Vercel)
ENVIRONMENT=production

# 6. CORS Allowed Origins — Use explicit URL(s), NOT * in production.
# Wildcard (*) disables credential-bearing requests (Authorization headers).
ALLOWED_ORIGINS=https://gradeguardian.vercel.app

# 7. Optional: Enable API docs (set to true only for local development)
# ENABLE_DOCS=false

