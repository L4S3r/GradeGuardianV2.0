# ─────────────────────────────────────────────────────────────────────────────
# 1. Cryptographic Security Keys (REQUIRED — all must be set)
# ─────────────────────────────────────────────────────────────────────────────

# HMAC key used to sign the grade data strings (SHA-256 HMAC via SECRET_SALT).
# WARNING: Never change after grades are created — all existing hashes will break.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_SALT=

# HMAC key dedicated to grade integrity (used by computeHash — separate from SECRET_SALT).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_SECRET=

# JWT signing secret. Changing this invalidates all active user sessions.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# How long JWTs stay valid (hours). Default: 24.
JWT_EXPIRE_HOURS=24

# Gate key required at professor registration. Share only with authorized staff.
# Generate: node -e "console.log('GG-FACULTY-' + require('crypto').randomBytes(24).toString('base64url'))"
FACULTY_SECRET_KEY=

# Second-factor key required to call /admin/rehash-grades.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 2. Password Hashing
# ─────────────────────────────────────────────────────────────────────────────

# bcrypt cost factor. Default 12 (~250ms on modern hardware).
# Increase on faster production servers for stronger hashing.
BCRYPT_ROUNDS=12

# ─────────────────────────────────────────────────────────────────────────────
# 3. Database (Supabase PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────

# Full Supabase connection string via the pooler (port 6543).
# Found in Supabase Dashboard → Project Settings → Database → Connection string (URI mode).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# 4. App Environment & Server
# ─────────────────────────────────────────────────────────────────────────────

# "production" | "development". In production, missing secrets crash the server at startup.
ENVIRONMENT=development

# TCP port for local dev. Vercel ignores this.
PORT=8000

# ─────────────────────────────────────────────────────────────────────────────
# 5. CORS — Allowed Frontend Origins
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated list of origins allowed to call the API.
# In production, set ONLY your real frontend domain(s).
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000,http://localhost:5173
