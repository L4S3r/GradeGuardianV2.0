# ─────────────────────────────────────────────────────────────────────────────
# GRADEGUARDIAN BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ─────────────────────────────────────────────────────────────────────────────

# 1. Cryptographic Security Keys
# Generate values with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_SALT=your_generated_secret_salt_here
JWT_SECRET=your_generated_jwt_secret_here

# 2. Supabase SDK Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_publishable_or_service_key

# 3. Supabase PostgreSQL Connection URL (Use Transaction Pooler on port 6543 for Vercel)
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-[your-region].pooler.supabase.com:6543/postgres?sslmode=require

# 4. App & Security Environment (Set to "production" on Vercel)
ENVIRONMENT=production

# 5. CORS Allowed Origins (Comma-separated URLs for web/mobile frontends or *)
ALLOWED_ORIGINS=*
